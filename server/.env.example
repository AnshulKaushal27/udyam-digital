# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5433/reachinbox_db?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Worker Concurrency & Rate Limiting
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=50

# JWT Authentication
JWT_SECRET=reachinbox_jwt_secret_token_dev_2026_secure

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth & Webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Elasticsearch (Optional: graceful fallback if offline)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Ethereal Email Credentials (optional - auto-created if empty)
ETHEREAL_USER=
ETHEREAL_PASS=
