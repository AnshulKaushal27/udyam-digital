        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-bold">Order ID</label>
            <input type="text" id="modalMilestoneOrderId" class="form-control form-control-sm font-monospace" readonly>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Select Next Milestone Stage</label>
            <select id="modalMilestoneStepSelect" class="form-select form-select-sm">
              <option value="2">Step 2: Digital Smart KYC Verification</option>
              <option value="3">Step 3: GIS Network Feasibility Cleared</option>
              <option value="4" selected>Step 4: Hardware Dispatched &amp; Engineer Assigned</option>
              <option value="5">Step 5: On-Site Installation &amp; Service Activated</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Assign Field Installation Engineer</label>
            <input type="text" id="modalEngineerName" class="form-control form-control-sm" value="Rahul Sharma">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Engineer Contact Phone</label>
            <input type="text" id="modalEngineerPhone" class="form-control form-control-sm" value="+91 98101 23456">
          </div>
          <div class="alert alert-light border small text-dark mb-0">
            <i class="bi bi-broadcast text-danger me-1"></i> Saving this update will <strong>immediately reflect</strong> on the consumer's portal.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-airtel btn-sm" onclick="saveMilestoneUpdate()">Update Milestone</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: KYC Officer Review & Decision -->
    <!-- Modal: KYC Officer Field-Level Inspection & Decision -->
  <div class="modal fade" id="kycReviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-dark text-white">
          <div>
            <h5 class="modal-title fw-bold fs-6 mb-0">Smart KYC Document &amp; Registry Verification Console</h5>
            <div class="small text-muted">Authoritative Comparison: Customer Data vs. Registry vs. Document OCR</div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <!-- Entity Summary Header -->
          <div class="card-kpi p-3 mb-3 bg-light border">
            <div class="row g-2 align-items-center">
              <div class="col-md-3">
                <div class="text-muted small">Application / Order ID</div>
                <div class="fw-bold font-monospace text-danger fs-6" id="kycModalOrderId">-</div>
              </div>
              <div class="col-md-3">
                <div class="text-muted small">Business Trade Name</div>
                <div class="fw-bold fs-6 text-dark" id="kycModalBizName">-</div>
              </div>
              <div class="col-md-3">
                <div class="text-muted small">Authorized Signatory</div>
                <div class="fw-bold text-dark" id="kycModalSignatory">-</div>
              </div>
              <div class="col-md-3">
                <div class="text-muted small">DPDP Consent Artifact</div>
                <span class="badge bg-success"><i class="bi bi-shield-lock-fill me-1"></i> Affirmative Consent Signed</span>
              </div>
            </div>
          </div>

          <!-- Actionable Exception Alert (Shown if verification failed or has anomalies) -->
          <div id="kycModalExceptionAlert" class="alert alert-danger border border-danger mb-3 p-3 rounded" style="display: none;">
            <div class="d-flex align-items-start gap-3">
              <i class="bi bi-exclamation-triangle-fill fs-4 text-danger mt-1"></i>
              <div>
                <h6 class="fw-bold text-danger mb-1" id="kycModalExceptionTitle">Verification Exception Detected</h6>
                <div class="small text-dark mb-1" id="kycModalExceptionEn">Customer-facing guidance...</div>
                <div class="small text-muted font-monospace" id="kycModalExceptionHi">Hindi guidance...</div>
              </div>
            </div>
          </div>

          <!-- Field-Level Comparison Matrix Table -->
          <div class="card-kpi p-0 overflow-hidden mb-3 border">
            <div class="p-2 px-3 border-bottom bg-light fw-bold small text-dark d-flex justify-content-between align-items-center">
              <span>FIELD-LEVEL CROSS-VALIDATION MATRIX</span>
              <span class="badge bg-secondary">Reference Date: 15-Jul-2026</span>
            </div>
            <div class="table-responsive">
              <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light">
                  <tr>
                    <th style="width: 22%;">Field</th>
                    <th style="width: 25%;">Customer Stated Data</th>
                    <th style="width: 25%;">Authoritative Registry Data</th>
                    <th style="width: 20%;">Document OCR Extraction</th>
                    <th style="width: 8%;" class="text-center">Verdict</th>
                  </tr>
                </thead>
                <tbody id="kycModalFieldTable">
                  <!-- Populated dynamically -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Officer Decision Desk (RBAC Gated) -->
          <div class="card-kpi p-3 bg-light border mb-3">
            <h6 class="fw-bold small text-muted mb-2"><i class="bi bi-pencil-square me-1"></i> KYC OFFICER ACTION &amp; RESOLUTION DESK</h6>
            <div class="mb-2">
              <label class="form-label small fw-bold text-muted mb-1">Officer Audit Remarks / Resubmission Instructions</label>
              <textarea id="kycOfficerRemarks" class="form-control form-control-sm" rows="2" placeholder="Enter specific instructions or reason for audit record..."></textarea>
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="makeKycDecision('REJECT')">
                  <i class="bi bi-x-circle me-1"></i> Reject Application
                </button>
                <button type="button" class="btn btn-outline-warning btn-sm text-dark" onclick="makeKycDecision('REQUEST_RESUBMISSION')">
                  <i class="bi bi-arrow-repeat me-1"></i> Request Resubmission
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="makeKycDecision('ESCALATE_MANUAL_REVIEW')">
                  <i class="bi bi-shield-exclamation me-1"></i> Escalate Field Survey
                </button>
              </div>
              <button type="button" class="btn btn-success btn-sm px-4 fw-bold" onclick="makeKycDecision('APPROVE')">
                <i class="bi bi-check-circle-fill me-1"></i> Approve KYC &amp; Clear for Feasibility
              </button>
            </div>
          </div>

          <!-- Immutable Audit Trail History -->
          <div class="p-2 border rounded bg-white">
            <div class="small fw-bold text-muted mb-1"><i class="bi bi-journal-text me-1"></i> Immutable Compliance Audit Trail:</div>
            <div id="kycModalAuditHistory" class="small text-muted font-monospace" style="max-height: 80px; overflow-y: auto;">
              No prior officer decisions recorded.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Officer Remarks / Rejection Reason</label>
            <input type="text" id="kycOfficerRemarks" class="form-control form-control-sm" value="All statutory DoT requirements verified against registry.">
          </div>
        </div>
        <div class="modal-footer d-flex justify-content-between">
          <div>
            <button type="button" class="btn btn-outline-danger btn-sm me-2" onclick="makeKycDecision('REJECTED')">
              <i class="bi bi-x-circle me-1"></i> Reject Application
            </button>
            <button type="button" class="btn btn-outline-warning btn-sm" onclick="makeKycDecision('RESUBMISSION_REQUESTED')">
              <i class="bi bi-arrow-repeat me-1"></i> Request Resubmission
            </button>
          </div>
          <button type="button" class="btn btn-success btn-sm px-3" onclick="makeKycDecision('APPROVED')">
            <i class="bi bi-check-circle-fill me-1"></i> Approve KYC Application
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    let activeRole = "{{ active_role }}";
    let selectedOrderId = null;

    function showSection(secId, el) {
      document.querySelectorAll(".sidebar-menu a").forEach(a => a.classList.remove("active"));
      if (el) el.classList.add("active");

      ['overview', 'quotes', 'recovery', 'orders', 'kyc', 'leads', 'partners', 'insights'].forEach(s => {
        const sec = document.getElementById("sec-" + s);
        if (sec) sec.style.display = (s === secId) ? "block" : "none";
      });

      if (secId === 'quotes') loadQuotesData();
      if (secId === 'recovery') loadRecoveryData();
    loadPartnerIntelligence();
      if (secId === 'orders') loadLiveOrders();
      if (secId === 'kyc') loadKycQueue();
      if (secId === 'leads') filterLeads();
      if (secId === 'partners') loadPartnerRescue();
      if (secId === 'insights') loadInsights();
    }

    
    function loadQuotesData() {
      fetch("/api/control/quotes/analytics")
        .then(r => r.json())
        .then(res => {
          if (res.status === "success") {
            document.getElementById("kpiTotalQuotes").innerText = res.total_quotes;
            document.getElementById("kpiConversionRate").innerText = res.funnel.conversion_rate_pct + "%";
            document.getElementById("kpiModifiedQuotes").innerText = res.funnel.modified;
            document.getElementById("kpiRejectionRate").innerText = res.funnel.rejection_rate_pct + "%";

            document.getElementById("funnelGenerated").innerText = res.funnel.generated;
            document.getElementById("funnelViewed").innerText = res.funnel.viewed;
            document.getElementById("funnelModified").innerText = res.funnel.modified;
            document.getElementById("funnelAccepted").innerText = res.funnel.accepted;
            document.getElementById("funnelOrders").innerText = res.funnel.orders;

            const rBox = document.getElementById("rejectionReasonsList");
            rBox.innerHTML = "";
            const reasons = Object.entries(res.rejection_reasons || {});
            if (reasons.length === 0) {
              rBox.innerHTML = `<span class="text-muted small">No rejections recorded. High acceptance rate!</span>`;
            } else {
              reasons.forEach(([reason, count]) => {
                const row = document.createElement("div");
                row.className = "d-flex justify-content-between align-items-center mb-1 pb-1 border-bottom";
                const cleanName = reason.replace(/_/g, " ").replace(/\b\w/g, l => l.toUpperCase());
                row.innerHTML = `<span class="text-dark">${cleanName}</span><span class="badge bg-danger-subtle text-danger">${count}</span>`;
                rBox.appendChild(row);
              });
            }
          }
        });

      fetch("/api/control/quotes")
        .then(r => r.json())
        .then(res => {
          if (res.status === "success") {
            const sideCount = document.getElementById("sideQuotesCount");
            if (sideCount) sideCount.innerText = res.count;

            const tbody = document.getElementById("controlQuotesTableBody");
            tbody.innerHTML = "";
            res.quotes.forEach(q => {
              const tr = document.createElement("tr");
              const p = q.pricing || {};
              const sub = p.monthly_subtotal_inr || q.monthly_base_inr || 0;
              const gst = p.gst_18_inr || Math.round(sub * 0.18);
              const total = p.final_monthly_payable_inr || (sub + gst);
              const setup = p.one_time_setup_inr || 0;

              let badgeClass = "bg-secondary";
              if (q.status === "accepted") badgeClass = "bg-success";
              else if (q.status === "rejected") badgeClass = "bg-danger";
              else if (q.status === "modified") badgeClass = "bg-info text-dark";
              else if (q.status === "viewed") badgeClass = "bg-primary";

              tr.innerHTML = `
                <td><strong class="font-monospace text-dark">${q.quote_id}</strong></td>
                <td><span class="text-muted small">${q.session_id || 'Self-Serve'}</span></td>
                <td><strong>${q.bundle_name}</strong><br><small class="text-muted">${q.addons && q.addons.length ? '+' + q.addons.length + ' add-on(s)' : 'Base only'}</small></td>
                <td class="fw-bold">₹${sub.toLocaleString()}</td>
                <td class="text-muted">₹${gst.toLocaleString()}</td>
                <td class="fw-bold text-danger">₹${total.toLocaleString()}/mo</td>
                <td>₹${setup.toLocaleString()}</td>
                <td><span class="badge ${badgeClass} text-uppercase">${q.status}</span></td>
                <td><span class="small text-muted">${q.created_at || 'Recently'}</span></td>
                <td class="text-end">
                  <button class="btn btn-sm btn-outline-dark py-0 px-2" onclick="alert('Quote Ref: ' + '${q.quote_id}' + '\\nBundle: ' + '${q.bundle_name}' + '\\nMonthly: ₹' + '${total}' + '\\nStatus: ' + '${q.status}')">
                    Inspect
                  </button>
                </td>
              `;
              tbody.appendChild(tr);
            });
          }
        });
    }

    function changeRole() {
      activeRole = document.getElementById("roleSelector").value;
      const names = {
        "super_admin": "Super Admin",
        "ops_manager": "Operations Manager",
        "kyc_officer": "KYC Officer",
        "sales_partner": "Channel Partner"
      };
      document.getElementById("userDisplayName").innerText = names[activeRole] || activeRole;
      loadLiveOrders();
      loadKycQueue();
    }

    // 1. Load Live Orders
    function loadLiveOrders() {
      fetch("/api/control/orders")
      .then(r => r.json())
      .then(data => {
        const tbody = document.getElementById("liveOrdersTbody");
        tbody.innerHTML = "";
        document.getElementById("sideLiveOrdersCount").innerText = data.total_orders;

        data.orders.forEach(o => {
          const tr = document.createElement("tr");

          let kycBadge = `<span class="badge bg-warning text-dark">${o.kyc.status}</span>`;
          if (o.kyc.status === "APPROVED") kycBadge = `<span class="badge bg-success">APPROVED</span>`;
          if (o.kyc.status === "REJECTED") kycBadge = `<span class="badge bg-danger">REJECTED</span>`;

          const engName = o.installation.assigned_engineer ? o.installation.assigned_engineer.name : "Unassigned";

          let actionBtn = "";
          if (activeRole === "super_admin" || activeRole === "ops_manager") {
            actionBtn = `<button class="btn btn-outline-danger btn-sm" onclick="openMilestoneModal('${o.order_id}', ${o.installation.current_step})"><i class="bi bi-pencil-square me-1"></i> Update Milestone</button>`;
          } else {
            actionBtn = `<span class="text-muted small">View Only</span>`;
          }

          tr.innerHTML = `
            <td><strong class="font-monospace text-danger">${o.order_id}</strong></td>
            <td><strong>${o.business_name}</strong><br><small class="text-muted">${o.contact_name}</small></td>
            <td>${o.city}</td>
            <td>${o.bundle_name}</td>
            <td><strong>₹${o.total_monthly.toLocaleString()}</strong>/mo</td>
            <td>${kycBadge}</td>
            <td><span class="badge bg-light text-dark border">${o.installation.status_text}</span></td>
            <td><small>${engName}</small></td>
            <td>${actionBtn}</td>
          `;
          tbody.appendChild(tr);
        });
      });
    }

    function openMilestoneModal(orderId, currentStep) {
      selectedOrderId = orderId;
      document.getElementById("modalMilestoneOrderId").value = orderId;
      document.getElementById("modalMilestoneStepSelect").value = Math.min(currentStep + 1, 5);
      const m = new bootstrap.Modal(document.getElementById('milestoneModal'));
      m.show();
    }

    function saveMilestoneUpdate() {
      const step = document.getElementById("modalMilestoneStepSelect").value;
      const engName = document.getElementById("modalEngineerName").value.trim();
      const engPhone = document.getElementById("modalEngineerPhone").value.trim();

      fetch(`/api/control/orders/${selectedOrderId}/update_milestone?role=${activeRole}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ step: step, engineer_name: engName, engineer_phone: engPhone })
      })
      .then(r => r.json())
      .then(res => {
        if (res.status === "success") {
          alert(`Order ${selectedOrderId} updated to Step ${step}! Synchronized with Consumer Portal.`);
          bootstrap.Modal.getInstance(document.getElementById('milestoneModal')).hide();
          loadLiveOrders();
        } else {
          alert("Error: " + res.message);
        }
      });
    }

    // 2. KYC Queue
    let currentKycFilter = "";
    let currentKycAppList = [];

    // 2. Smart KYC & Exception Queue Loader
    function loadKycQueue(filter = "") {
      currentKycFilter = filter;
      fetch(`/api/kyc/queue?status=${encodeURIComponent(filter)}`)
      .then(r => r.json())
      .then(data => {
        if (data.status !== "success") return;
        currentKycAppList = data.applications || [];

        // Update KPIs
        const m = data.metrics || {};
        document.getElementById("kycPendingCountBadge").innerText = m.pending_count || 0;
        document.getElementById("kycApprovedCountBadge").innerText = m.auto_verified_count || 0;
        document.getElementById("kycExceptionsCountBadge").innerText = m.exceptions_count || 0;
        if (document.getElementById("kycAvgOcrBadge")) {
          document.getElementById("kycAvgOcrBadge").innerText = m.avg_ocr_confidence || "97.4%";
        }
        if (document.getElementById("sidePendingKycCount")) {
          document.getElementById("sidePendingKycCount").innerText = (m.pending_count || 0) + (m.exceptions_count || 0);
        }

        const tbody = document.getElementById("kycQueueTbody");
        tbody.innerHTML = "";

        if (currentKycAppList.length === 0) {
          tbody.innerHTML = `<tr><td colspan="9" class="text-center text-muted py-4">No verification applications matching current filter.</td></tr>`;
          return;
        }

        currentKycAppList.forEach(app => {
          const tr = document.createElement("tr");

          let statusBadge = "";
          if (app.status === "VERIFIED_APPROVED" || app.status === "APPROVED") {
            statusBadge = `<span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> VERIFIED</span>`;
          } else if (app.status === "EXCEPTION_FAILED" || app.status === "REJECTED") {
            statusBadge = `<span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i> EXCEPTION</span>`;
          } else {
            statusBadge = `<span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i> REVIEW REQ</span>`;
          }

          const billBadge = app.bill_age_days <= 90
            ? `<span class="badge bg-success">${app.bill_date} (${app.bill_age_days}d)</span>`
            : `<span class="badge bg-danger">${app.bill_date} (${app.bill_age_days}d > 90d)</span>`;

          let actionBtn = "";
          if (activeRole === "super_admin" || activeRole === "kyc_officer") {
            actionBtn = `<button class="btn btn-sm btn-outline-danger fw-bold" onclick="openKycReviewModal('${app.application_id}')"><i class="bi bi-search me-1"></i> Inspect &amp; Decide</button>`;
          } else {
            actionBtn = `<button class="btn btn-sm btn-outline-secondary" onclick="openKycReviewModal('${app.application_id}')"><i class="bi bi-eye me-1"></i> View Only</button>`;
          }

          tr.innerHTML = `
            <td><code class="fw-bold ${app.is_specimen ? 'text-primary' : 'text-danger'}">${app.application_id}</code>${app.is_specimen ? ' <span class="badge bg-dark" style="font-size:0.65rem;">SPECIMEN</span>' : ''}</td>
            <td><strong>${app.applicant_name}</strong></td>
            <td>${app.business_name}</td>
            <td class="font-monospace">${app.masked_gstin}</td>
            <td class="font-monospace">${app.udyam_number || 'N/A'}</td>
            <td>${billBadge}</td>
            <td><span class="badge bg-light text-dark border">${app.ocr_confidence}</span></td>
            <td>${statusBadge}</td>
            <td>${actionBtn}</td>
          `;
          tbody.appendChild(tr);
        });
      });
    }

    function filterKycTable(filterCode) {
      document.querySelectorAll("#sec-kyc .btn-group button").forEach(b => b.classList.remove("active"));
      if (filterCode === "") document.getElementById("kycTabAll").classList.add("active");
      else if (filterCode === "PENDING") document.getElementById("kycTabPending").classList.add("active");
      else if (filterCode === "APPROVED") document.getElementById("kycTabVerified").classList.add("active");
      else if (filterCode === "EXCEPTION") document.getElementById("kycTabExceptions").classList.add("active");
      loadKycQueue(filterCode);
    }

    // 1-Click Specimen Benchmark Tester
    function testSpecimenKyc(applicantId) {
      fetch(`/api/kyc/specimen/${applicantId}`)
      .then(r => r.json())
      .then(res => {
        if (res.status === "success") {
          renderKycModalFromReport(res.report);
          const m = new bootstrap.Modal(document.getElementById('kycReviewModal'));
          m.show();
        } else {
          alert("Error: " + res.message);
        }
      });
    }

    function openKycReviewModal(appId) {
      selectedOrderId = appId;
      // If it's a specimen (K01-K12)
      if (appId.startsWith("K0") || appId.startsWith("K1")) {
        testSpecimenKyc(appId);
        return;
      }
      // If it's a live order
      const app = currentKycAppList.find(x => x.application_id === appId);
      if (app) {
        renderKycModalFromQueueApp(app);
        const m = new bootstrap.Modal(document.getElementById('kycReviewModal'));
        m.show();
      } else {
        fetch("/api/control/orders")
        .then(r => r.json())
        .then(data => {
          const o = data.orders.find(x => x.order_id === appId);
          if (o) {
            renderKycModalFromOrder(o);
            const m = new bootstrap.Modal(document.getElementById('kycReviewModal'));
            m.show();
          }
        });
      }
    }

    function renderKycModalFromReport(rep) {
      selectedOrderId = rep.applicant_id;
      document.getElementById("kycModalOrderId").innerText = rep.applicant_id;
      document.getElementById("kycModalBizName").innerText = rep.business_name;
      document.getElementById("kycModalSignatory").innerText = rep.applicant_name;

      // Exception alert
      const alertBox = document.getElementById("kycModalExceptionAlert");
      if (rep.exceptions && rep.exceptions.length > 0) {
        const ex = rep.exceptions[0];
        document.getElementById("kycModalExceptionTitle").innerText = `${ex.category}: ${ex.title}`;
        document.getElementById("kycModalExceptionEn").innerText = ex.message;
        document.getElementById("kycModalExceptionHi").innerText = `Hindi Guidance: "${ex.message_hi || ''}"`;
        alertBox.style.display = "block";
      } else {
        alertBox.style.display = "none";
      }

      // Populate comparison matrix table
      const tbody = document.getElementById("kycModalFieldTable");
      tbody.innerHTML = "";
      (rep.field_comparison || []).forEach(row => {
        const tr = document.createElement("tr");
        let badge = "bg-secondary";
        if (row.result === "PASS") badge = "bg-success";
        else if (row.result === "FAIL") badge = "bg-danger";
        else if (row.result === "REVIEW") badge = "bg-warning text-dark";

        tr.innerHTML = `
          <td><strong>${row.field}</strong></td>
          <td class="font-monospace">${row.customer_data}</td>
          <td class="font-monospace">${row.registry_data}</td>
          <td class="font-monospace">${row.ocr_data}</td>
          <td class="text-center"><span class="badge ${badge}">${row.result}</span></td>
        `;
        tbody.appendChild(tr);
      });

      // Audit history
      fetch(`/api/kyc/audit?application_id=${rep.applicant_id}`)
      .then(r => r.json())
      .then(aud => {
        const box = document.getElementById("kycModalAuditHistory");
        if (aud.audit_trail && aud.audit_trail.length > 0) {
          box.innerHTML = aud.audit_trail.map(a => `[${a.timestamp_ist}] ${a.officer_name} (${a.officer_role}) -> ${a.action}: "${a.reasons}"`).join("<br>");
        } else {
          box.innerText = "No previous decision entries. First inspection on record.";
        }
      });
    }

    function renderKycModalFromQueueApp(app) {
      selectedOrderId = app.application_id;
      document.getElementById("kycModalOrderId").innerText = app.application_id;
      document.getElementById("kycModalBizName").innerText = app.business_name;
      document.getElementById("kycModalSignatory").innerText = app.applicant_name;

      const alertBox = document.getElementById("kycModalExceptionAlert");
      if (app.exceptions && app.exceptions.length > 0) {
        const ex = app.exceptions[0];
        document.getElementById("kycModalExceptionTitle").innerText = `${ex.category}: ${ex.title}`;
        document.getElementById("kycModalExceptionEn").innerText = ex.message;
        document.getElementById("kycModalExceptionHi").innerText = `Hindi Guidance: "${ex.message_hi || ''}"`;
        alertBox.style.display = "block";
      } else {
        alertBox.style.display = "none";
      }

      const tbody = document.getElementById("kycModalFieldTable");
      tbody.innerHTML = "";
      (app.field_comparison || []).forEach(row => {
        const tr = document.createElement("tr");
        let badge = row.result === "PASS" ? "bg-success" : (row.result === "FAIL" ? "bg-danger" : "bg-warning text-dark");
        tr.innerHTML = `
          <td><strong>${row.field}</strong></td>
          <td class="font-monospace">${row.customer_data}</td>
          <td class="font-monospace">${row.registry_data}</td>
          <td class="font-monospace">${row.ocr_data}</td>
          <td class="text-center"><span class="badge ${badge}">${row.result}</span></td>
        `;
        tbody.appendChild(tr);
      });

      fetch(`/api/kyc/audit?application_id=${app.application_id}`)
      .then(r => r.json())
      .then(aud => {
        const box = document.getElementById("kycModalAuditHistory");
        if (aud.audit_trail && aud.audit_trail.length > 0) {
          box.innerHTML = aud.audit_trail.map(a => `[${a.timestamp_ist}] ${a.officer_name} (${a.officer_role}) -> ${a.action}: "${a.reasons}"`).join("<br>");
        } else {
          box.innerText = "No previous decision entries recorded.";
        }
      });
    }

    function renderKycModalFromOrder(o) {
      selectedOrderId = o.order_id;
      document.getElementById("kycModalOrderId").innerText = o.order_id;
      document.getElementById("kycModalBizName").innerText = o.business_name;
      document.getElementById("kycModalSignatory").innerText = o.kyc.signatory_name;

      const alertBox = document.getElementById("kycModalExceptionAlert");
      alertBox.style.display = "none";

      const tbody = document.getElementById("kycModalFieldTable");
      tbody.innerHTML = `
        <tr>
          <td><strong>Business / Trade Name</strong></td>
          <td class="font-monospace">${o.business_name}</td>
          <td class="font-monospace">${o.business_name} (Active)</td>
          <td class="font-monospace">${o.business_name}</td>
          <td class="text-center"><span class="badge bg-success">PASS</span></td>
        </tr>
        <tr>
          <td><strong>GST Registration</strong></td>
          <td class="font-monospace">${o.kyc.masked_gstin}</td>
          <td class="font-monospace">Active</td>
          <td class="font-monospace">${o.kyc.masked_gstin}</td>
          <td class="text-center"><span class="badge bg-success">PASS</span></td>
        </tr>
        <tr>
          <td><strong>Utility Bill Date (<90d)</strong></td>
          <td class="font-monospace">${o.kyc.utility_bill_date}</td>
          <td class="font-monospace">Benchmark: 15-Jul-2026</td>
          <td class="font-monospace">${o.kyc.utility_bill_date} (${o.kyc.bill_age_days}d old)</td>
          <td class="text-center"><span class="badge bg-success">PASS</span></td>
        </tr>
      `;

      fetch(`/api/kyc/audit?application_id=${o.order_id}`)
      .then(r => r.json())
      .then(aud => {
        const box = document.getElementById("kycModalAuditHistory");
        if (aud.audit_trail && aud.audit_trail.length > 0) {
          box.innerHTML = aud.audit_trail.map(a => `[${a.timestamp_ist}] ${a.officer_name} (${a.officer_role}) -> ${a.action}: "${a.reasons}"`).join("<br>");
        } else {
          box.innerText = `Current Status: ${o.kyc.status} · Notes: ${o.kyc.audit_notes}`;
        }
      });
    }

    function makeKycDecision(action) {
      const remarks = document.getElementById("kycOfficerRemarks").value.trim();

      fetch(`/api/kyc/action?role=${activeRole}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          application_id: selectedOrderId,
          action: action,
          officer_name: "KYC Officer (S. Sen)",
          reasons: remarks || `Action ${action} executed by KYC Officer.`,
          actionable_instructions: remarks
        })
      })
      .then(r => r.json())
      .then(res => {
        if (res.status === "success") {
          alert(`Application ${selectedOrderId} updated: ${action}!
Audit Artifact: ${res.audit_id}`);
          const modalEl = document.getElementById('kycReviewModal');
          const modalInstance = bootstrap.Modal.getInstance(modalEl);
          if (modalInstance) modalInstance.hide();
          loadKycQueue(currentKycFilter);
          loadLiveOrders();
        } else {
          alert(`Action Failed (${res.http_code || 400}): ${res.message}`);
        }
      });
    }

    function triggerDpdpPurgeSimulator() {
      fetch("/api/kyc/dpdp/purge", { method: "POST" })
      .then(r => r.json())
      .then(res => {
        alert(`DPDP Act 2023 Ephemeral Buffer Purge Executed!

Policy: ${res.policy}
Purged Files: ${res.purged_count}
Receipt: ${res.cryptographic_receipt}`);
        loadKycQueue(currentKycFilter);
      });
    }

    // 3. Leads Database Filter
    function filterLeads() {
      const search = document.getElementById("leadSearchInput").value.trim();
      const seg = document.getElementById("leadSegmentFilter").value;
      const stage = document.getElementById("leadStageFilter").value;

      fetch(`/api/control/leads?search=${encodeURIComponent(search)}&segment=${encodeURIComponent(seg)}&stage=${encodeURIComponent(stage)}&limit=30`)
      .then(r => r.json())
      .then(data => {
        const tbody = document.getElementById("leadsTableBody");
        tbody.innerHTML = "";
        data.leads.forEach(l => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td><code>${l.lead_id}</code></td>
            <td><strong>${l.business_name}</strong></td>
            <td>${l.segment}</td>
            <td>${l.city} (${l.city_tier})</td>
            <td>${l.lead_source}</td>
            <td><span class="badge bg-light text-dark border">${l.stage_reached}</span></td>
            <td><span class="badge bg-${l.has_gstin === 'Y' ? 'success' : 'secondary'}">${l.has_gstin}</span></td>
            <td><small class="text-${l.outcome === 'Activated' ? 'success' : 'danger'}">${l.outcome === 'Activated' ? 'Activated' : l.drop_reason}</small></td>
          `;
          tbody.appendChild(tr);
        });
      });
    }

    // 4. Partner Rescue
    function loadPartnerRescue() {
      fetch("/api/partner/leads")
      .then(r => r.json())
      .then(data => {
        const tbody = document.getElementById("partnerRescueTbody");
        tbody.innerHTML = "";
        data.leads.forEach(l => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td><code>${l.lead_id}</code></td>
            <td><strong>${l.business_name}</strong></td>
            <td>${l.city}</td>
            <td>₹${l.current_spend.toLocaleString()}</td>
            <td><small class="text-danger">${l.drop_reason}</small></td>
            <td><span class="badge bg-${l.priority_badge}">${l.propensity_score}</span></td>
            <td>
              <button class="btn btn-sm btn-outline-danger" onclick="alert('Initiating WhatsApp / Call follow-up for ${l.business_name}')">
                <i class="bi bi-telephone-fill"></i> Reach Out
              </button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      });
    }

    // 5. Business Insights
    function loadInsights() {
      fetch("/api/control/analytics/insights")
      .then(r => r.json())
      .then(data => {
        const box = document.getElementById("insightsContainer");
        box.innerHTML = "";
        data.insights.forEach(i => {
          const col = document.createElement("div");
          col.className = "col-md-6";
          col.innerHTML = `
            <div class="card-kpi p-4 h-100 border-start border-4 border-danger">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-danger">${i.category}</span>
                <span class="small fw-bold text-dark">${i.stat}</span>
              </div>
              <h5 class="fw-bold text-dark mb-2">${i.title}</h5>
              <p class="small text-muted mb-3">${i.evidence}</p>
              <div class="p-2 bg-light rounded small border">
                <strong>Strategic Recommendation:</strong> ${i.recommendation}
              </div>
            </div>
          `;
          box.appendChild(col);
        });
      });
    }


    // =========================================================================
    // PHASE 3: AI QUOTE RECOVERY ENGINE JAVASCRIPT
    // =========================================================================
    let currentRecoveryRecords = [];
    let activeRecoveryFilter = 'all';
    let activeModalRecoveryId = null;

    function loadRecoveryData() {
      // 1. Fetch Analytics
      fetch('/api/control/recovery/analytics')
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            const m = data.live_metrics;
            document.getElementById('kpiTotalAbandoned').textContent = m.total_abandoned;
            document.getElementById('kpiDraftReady').textContent = m.draft_ready;
            document.getElementById('kpiContacted').textContent = m.contacted;
            document.getElementById('kpiRecovered').textContent = m.recovered;
            document.getElementById('kpiRecoveryRate').textContent = m.recovery_rate_pct + '% Win-back';
            document.getElementById('kpiRecoveredRevenue').textContent = '₹' + m.recovered_monthly_revenue_inr.toLocaleString() + '/mo Revived Revenue';
            
            const sideBadge = document.getElementById('sideRecoveryCount');
            if (sideBadge) sideBadge.textContent = m.total_abandoned;

            // Render objection distribution pills
            const distBox = document.getElementById('objectionDistributionContainer');
            if (distBox) {
              distBox.innerHTML = '';
              Object.entries(data.objection_distribution).forEach(([k, v]) => {
                if (v.count > 0 || ['price_too_high', 'technical_complexity', 'installation_timeline', 'missing_requirement', 'not_ready'].includes(k)) {
                  const pill = document.createElement('div');
                  pill.className = 'p-2 bg-light border rounded small d-flex align-items-center gap-2';
                  pill.style.minWidth = '175px';
                  pill.innerHTML = `
                    <span class="badge bg-secondary font-monospace">${v.count}</span>
                    <div>
                      <div class="fw-bold text-dark" style="font-size: 0.76rem;">${v.label}</div>
                      <div class="text-muted" style="font-size: 0.70rem;">${v.pct}% of active queue</div>
                    </div>
                  `;
                  distBox.appendChild(pill);
                }
              });
            }
          }
        })
        .catch(err => console.error("Error loading recovery analytics:", err));

      // 2. Fetch Records Queue
      fetch('/api/control/recovery/queue?filter=' + activeRecoveryFilter)
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            currentRecoveryRecords = data.records;
            renderRecoveryTable(currentRecoveryRecords);
            
            // High priority count
            const highCount = currentRecoveryRecords.filter(r => r.priority_score >= 70).length;
            const hpEl = document.getElementById('kpiHighPriorityCount');
            if (hpEl) hpEl.textContent = highCount + ' High Priority';
          }
        })
        .catch(err => console.error("Error loading recovery queue:", err));
    }

    function renderRecoveryTable(records) {
      const tbody = document.getElementById('recoveryTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';

      if (!records || records.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-muted small">No recovery opportunities matching filter.</td></tr>`;
        return;
      }

      records.forEach(r => {
        const tr = document.createElement('tr');
        const scoreColor = r.priority_score >= 70 ? 'success' : (r.priority_score >= 45 ? 'warning' : 'secondary');
        const statusBadge = {
          'draft_ready': '<span class="badge bg-warning text-dark"><i class="bi bi-pencil-fill me-1"></i>Draft Ready</span>',
          'contacted': '<span class="badge bg-primary"><i class="bi bi-telephone-fill me-1"></i>Contacted</span>',
          'recovered': '<span class="badge bg-success"><i class="bi bi-trophy-fill me-1"></i>Recovered</span>',
          'closed_lost': '<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Closed Lost</span>',
          'opted_out': '<span class="badge bg-secondary"><i class="bi bi-slash-circle me-1"></i>Opted Out</span>'
        }[r.recovery_status] || `<span class="badge bg-light text-dark">${r.recovery_status}</span>`;

        tr.innerHTML = `
          <td><code>${r.recovery_id}</code></td>
          <td>
            <strong>${r.business_name}</strong>
            <div class="small text-muted">${r.contact_person} &bull; ${r.contact_phone}</div>
          </td>
          <td>
            <div class="small fw-semibold text-dark">${r.recommended_bundle}</div>
            <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.68rem;">${r.quote_id}</span>
          </td>
          <td>
            <strong>₹${r.monthly_quoted_inr.toLocaleString()}/mo</strong>
            <div class="small text-muted" style="font-size: 0.72rem;">1st pay: ₹${r.total_first_payment_inr.toLocaleString()}</div>
          </td>
          <td>
            <span class="badge bg-${r.objection_badge_class || 'danger'}"><i class="bi ${r.objection_icon || 'bi-exclamation-circle'} me-1"></i>${r.objection_label}</span>
          </td>
          <td>
            <div class="d-flex align-items-center gap-1">
              <span class="badge bg-${scoreColor}">${r.priority_score}</span>
              <span class="small text-muted" style="font-size: 0.70rem;">(${r.priority_tier})</span>
            </div>
          </td>
          <td>${statusBadge}</td>
          <td><small class="text-muted">${r.assigned_agent}</small></td>
          <td class="text-end">
            <button class="btn btn-sm btn-outline-danger" onclick="openRecoveryModal('${r.recovery_id}')">
              <i class="bi bi-arrow-repeat me-1"></i>Review &amp; Recover
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filterRecovery(filterType, btn) {
      activeRecoveryFilter = filterType;
      document.querySelectorAll('#recoveryFilterTabs button').forEach(b => {
        b.classList.remove('btn-dark');
        b.classList.add('btn-outline-secondary');
      });
      if (btn) {
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-dark');
      }
      loadRecoveryData();
    loadPartnerIntelligence();
    }

    function searchRecoveryTable() {
      const q = (document.getElementById('recoverySearchInput').value || '').trim().toLowerCase();
      if (!q) {
        renderRecoveryTable(currentRecoveryRecords);
        return;
      }
      const filtered = currentRecoveryRecords.filter(r => 
        r.business_name.toLowerCase().includes(q) ||
        r.recovery_id.toLowerCase().includes(q) ||
        r.quote_id.toLowerCase().includes(q) ||
        r.objection_label.toLowerCase().includes(q) ||
        r.assigned_agent.toLowerCase().includes(q)
      );
      renderRecoveryTable(filtered);
    }

    function openRecoveryModal(recoveryId) {
      activeModalRecoveryId = recoveryId;
      fetch('/api/control/recovery/' + recoveryId)
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            const r = data.record;
            document.getElementById('recModalBusinessName').textContent = r.business_name;
            document.getElementById('recModalId').textContent = r.recovery_id;
            document.getElementById('recModalQuoteId').textContent = r.quote_id;
            document.getElementById('recModalContact').textContent = r.contact_person;
            document.getElementById('recModalPhone').textContent = r.contact_phone;
            document.getElementById('recModalSegment').textContent = r.business_category.toUpperCase();
            document.getElementById('recModalBudget').textContent = r.customer_budget_inr ? ('₹' + Number(r.customer_budget_inr).toLocaleString() + '/mo') : 'Not specified';
            document.getElementById('recModalBundle').textContent = r.recommended_bundle;
            document.getElementById('recModalPricing').textContent = '₹' + r.monthly_quoted_inr.toLocaleString() + '/mo (1st Pay: ₹' + r.total_first_payment_inr.toLocaleString() + ')';
            
            // Objection & Evidence
            const objBadge = document.getElementById('recModalObjectionBadge');
            objBadge.className = 'badge bg-' + (r.objection_badge_class || 'danger');
            objBadge.textContent = r.objection_label;
            document.getElementById('recModalEvidence').textContent = `"${r.supporting_evidence}"`;

            // Score & Tier
            const scoreBadge = document.getElementById('recModalScoreTier');
            scoreBadge.className = 'badge bg-' + r.priority_tier_color;
            scoreBadge.textContent = r.priority_tier;
            document.getElementById('recModalScoreValue').textContent = `${r.priority_score} / 100`;

            // Factor Breakdown
            const factorsBox = document.getElementById('recModalFactorsList');
            factorsBox.innerHTML = '';
            Object.entries(r.score_factors || {}).forEach(([fKey, fVal]) => {
              const row = document.createElement('div');
              row.className = 'd-flex justify-content-between align-items-center';
              row.innerHTML = `
                <span class="text-muted text-capitalize">${fKey.replace('_', ' ')}:</span>
                <div class="d-flex align-items-center gap-2">
                  <span class="text-muted" style="font-size: 0.72rem;">${fVal.detail}</span>
                  <span class="badge bg-light text-dark border font-monospace">${fVal.score}/${fVal.max}</span>
                </div>
              `;
              factorsBox.appendChild(row);
            });

            // Strategy & Action
            document.getElementById('recModalActionTitle').textContent = r.action_title || 'Consultative Outreach';
            document.getElementById('recModalActionDesc').textContent = r.suggested_next_action || 'Review opportunity with customer.';
            
            const viableBox = document.getElementById('recModalViableAltBox');
            if (r.viable_alternative) {
              viableBox.style.display = 'block';
              document.getElementById('recModalViableAltText').textContent = `${r.viable_alternative.name} @ ₹${r.viable_alternative.monthly_inr.toLocaleString()}/mo (${r.viable_alternative.note || ''})`;
            } else {
              viableBox.style.display = 'none';
            }

            // AI Draft Text
            const draftObj = r.ai_draft_message || {};
            document.getElementById('recModalDraftText').value = draftObj.full_text || draftObj.body || '';
            document.getElementById('recDraftLangSelect').value = draftObj.language || 'hi';

            // Re-Entry URL
            const fullReentry = window.location.origin + r.reentry_url;
            document.getElementById('recModalReentryLink').value = fullReentry;

            // Agent assignment
            document.getElementById('recModalAgentSelect').value = r.assigned_agent || 'Ramesh Sharma (Airtel MSME Growth Desk)';

            const modal = new bootstrap.Modal(document.getElementById('recoveryDetailModal'));
            modal.show();
          }
        });
    }

    function refreshRecoveryDraft(lang) {
      if (!activeModalRecoveryId) return;
      fetch('/api/control/recovery/' + activeModalRecoveryId + '/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'generate_draft', language: lang })
      })
      .then(r => r.json())
      .then(data => {
        if (data.status === 'success') {
          document.getElementById('recModalDraftText').value = data.draft.full_text || data.draft.body;
        }
      });
    }

    function copyReentryLink() {
      const el = document.getElementById('recModalReentryLink');
      el.select();
      navigator.clipboard.writeText(el.value);
      alert('Secure customer recovery link copied to clipboard!');
    }

    function executeRecoveryAction(action) {
      if (!activeModalRecoveryId) return;
      let payload = { action: action };
      if (action === 'assign') {
        payload.agent_name = document.getElementById('recModalAgentSelect').value;
      } else if (action === 'update_draft') {
        payload.draft_text = document.getElementById('recModalDraftText').value;
      }

      fetch('/api/control/recovery/' + activeModalRecoveryId + '/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(r => r.json())
      .then(data => {
        if (data.status === 'success') {
          alert('Action executed: ' + data.message);
          const modalEl = document.getElementById('recoveryDetailModal');
          const modalInstance = bootstrap.Modal.getInstance(modalEl);
          if (modalInstance) modalInstance.hide();
          loadRecoveryData();
    loadPartnerIntelligence();
        } else {
          alert('Error: ' + data.message);
        }
      });
    }

    function triggerRecoveryScan() {
      alert('Scanning active quotes for abandonment: 5 active cases identified, prioritized, and drafts refreshed.');
      loadRecoveryData();
    loadPartnerIntelligence();
    }

    
    // =========================================================================
    // PHASE 4: ASSISTED DIGITAL PARTNER ECOSYSTEM JAVASCRIPT
    // =========================================================================
    let activePartnerId = 'PTR-DEL-042';
    let assistedCurrentCategory = 'kirana';

    function switchPartnerView(partnerId) {
      activePartnerId = partnerId;
      loadPartnerIntelligence();
    }

    function loadPartnerIntelligence() {
      const pId = activePartnerId;
      
      // 1. Fetch Partner Analytics
      fetch('/api/partner/' + pId + '/analytics')
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            const m = data.metrics;
            document.getElementById('ptrKpiReferred').textContent = m.total_referred_sessions;
            document.getElementById('ptrKpiOrders').textContent = m.total_orders_placed;
            document.getElementById('ptrKpiPendingActivations').textContent = m.pending_activations + ' Pending Act';
            document.getElementById('ptrKpiActivations').textContent = m.total_activations;
            document.getElementById('ptrKpiConversionRate').textContent = m.conversion_rate_pct + '% Conv';
            document.getElementById('ptrKpiEarnedComm').textContent = '₹' + m.commission_earned_inr.toLocaleString();
            document.getElementById('ptrKpiPendingComm').textContent = '₹' + m.commission_pending_inr.toLocaleString() + ' Pending';
          }
        })
        .catch(err => console.error("Error loading partner analytics:", err));

      // 2. Fetch Partner Profile & QR Code
      const singleId = (pId === 'ALL') ? 'PTR-DEL-042' : pId;
      fetch('/api/partner/' + singleId + '/profile')
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            const p = data.partner;
            document.getElementById('ptrKpiReferralCode').textContent = p.referral_code;
            document.getElementById('partnerReferralUrlInput').value = data.referral_url;
            
            // Render QR Code SVG
            fetch('/api/partner/' + singleId + '/qr')
              .then(res => res.text())
              .then(svg => {
                document.getElementById('partnerQrContainer').innerHTML = svg;
              });

            // Update Assisted Mode Header names
            const hName = document.getElementById('assistedActivePartnerName');
            if (hName) hName.textContent = `${p.name} (${p.agency_name})`;
            const hBadge = document.getElementById('assistedPartnerIdBadge');
            if (hBadge) hBadge.textContent = p.partner_id;
          }
        })
        .catch(err => console.error("Error loading partner profile:", err));

      // 3. Fetch Commission Ledger
      const userRole = (pId === 'ALL') ? 'super_admin' : 'channel_partner';
      fetch('/api/partner/' + pId + '/commissions?role=' + userRole + '&user_partner_id=' + pId)
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            renderCommissionLedger(data.commissions);
            document.getElementById('ledgerCountBadge').textContent = data.count + ' Records';
          }
        })
        .catch(err => console.error("Error loading commissions:", err));

      // 4. Fetch Partner Lead Rescue Desk
      fetch('/api/partner/' + singleId + '/leads')
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            renderPartnerRescueDesk(data.leads);
            document.getElementById('partnerLeadsCountBadge').textContent = data.count + ' Opportunities Available';
          }
        })
        .catch(err => console.error("Error loading partner rescue leads:", err));
    }

    function renderCommissionLedger(records) {
      const tbody = document.getElementById('partnerCommissionTbody');
      if (!tbody) return;
      tbody.innerHTML = '';

      if (!records || records.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="text-center py-3 text-muted small">No commission records for this partner view.</td></tr>`;
        return;
      }

      records.forEach(c => {
        const tr = document.createElement('tr');
        const statusBadge = {
          'pending': '<span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Pending Act</span>',
          'eligible': '<span class="badge bg-primary"><i class="bi bi-check-circle-fill me-1"></i>Eligible (Activated)</span>',
          'approved': '<span class="badge bg-info text-dark"><i class="bi bi-patch-check-fill me-1"></i>Approved</span>',
          'paid': '<span class="badge bg-success"><i class="bi bi-cash-stack me-1"></i>Paid (NEFT)</span>',
          'reversed': '<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Reversed</span>'
        }[c.status] || `<span class="badge bg-light text-dark">${c.status}</span>`;

        let actionBtns = '';
        if (c.status === 'eligible') {
          actionBtns = `<button class="btn btn-xs btn-outline-success" onclick="executeCommissionAction('${c.commission_id}', 'approve')"><i class="bi bi-check-lg me-1"></i>Approve</button>`;
        } else if (c.status === 'approved') {
          actionBtns = `<button class="btn btn-xs btn-success" onclick="executeCommissionAction('${c.commission_id}', 'mark_paid')"><i class="bi bi-cash me-1"></i>Pay Now</button>`;
        } else if (c.status === 'pending') {
          actionBtns = `<span class="text-muted small">Awaiting Step 5</span>`;
        } else {
          actionBtns = `<span class="text-muted small">Finalized</span>`;
        }

        tr.innerHTML = `
          <td><code>${c.commission_id}</code></td>
          <td><code>${c.order_id}</code></td>
          <td>
            <strong>${c.customer_name}</strong>
            <div class="text-muted small" style="font-size: 0.70rem;">${c.bundle_name}</div>
          </td>
          <td>₹${c.monthly_subtotal_inr.toLocaleString()}/mo</td>
          <td><strong class="text-dark">₹${c.commission_amount_inr.toLocaleString()}</strong></td>
          <td>${statusBadge}</td>
          <td><small class="text-muted">${c.created_at_display || 'Recent'}</small></td>
          <td class="text-end">${actionBtns}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function executeCommissionAction(commissionId, action) {
      fetch('/api/partner/commission/' + commissionId + '/action?role=super_admin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: action, admin_user: 'Airtel Finance Manager' })
      })
      .then(r => r.json())
      .then(data => {
        if (data.status === 'success') {
          alert('Commission updated: ' + action.toUpperCase());
          loadPartnerIntelligence();
        } else {
          alert('Error: ' + data.message);
        }
      });
    }

    function renderPartnerRescueDesk(leads) {
      const tbody = document.getElementById('partnerRescueDeskTbody');
      if (!tbody) return;
      tbody.innerHTML = '';

      if (!leads || leads.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="text-center py-3 text-muted small">No recovery opportunities currently unassigned in your territory.</td></tr>`;
        return;
      }

      leads.forEach(l => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><code>${l.recovery_id}</code></td>
          <td><strong>${l.business_name}</strong><div class="small text-muted">${l.contact_person}</div></td>
          <td>${l.recommended_bundle}</td>
          <td><span class="badge bg-danger">${l.objection_label}</span></td>
          <td><span class="badge bg-success">${l.priority_score} (${l.priority_tier})</span></td>
          <td><small class="text-muted">${l.created_at_display || 'Recent'}</small></td>
          <td><small class="text-dark">${l.action_title || l.suggested_next_action}</small></td>
          <td class="text-end">
            <button class="btn btn-sm btn-outline-danger" onclick="claimPartnerLead('${l.recovery_id}')">
              <i class="bi bi-person-check me-1"></i>Claim &amp; Visit
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function claimPartnerLead(recoveryId) {
      const singleId = (activePartnerId === 'ALL') ? 'PTR-DEL-042' : activePartnerId;
      fetch('/api/partner/' + singleId + '/lead/' + recoveryId + '/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(r => r.json())
      .then(data => {
        if (data.status === 'success') {
          alert('Opportunity claimed! Lead assigned to you in Recovery Hub.');
          loadPartnerIntelligence();
        }
      });
    }

    function copyPartnerReferralLink() {
      const el = document.getElementById('partnerReferralUrlInput');
      el.select();
      navigator.clipboard.writeText(el.value);
      alert('Partner referral link copied to clipboard!');
    }

    // =========================================================================
    // ASSISTED TABLET MODE RUNTIME LOGIC
    // =========================================================================
    function openAssistedModeModal() {
      const modal = new bootstrap.Modal(document.getElementById('assistedModeModal'));
      modal.show();
      assistedSelectCategory('kirana', null);
    }

    function assistedSelectCategory(cat, btn) {
      assistedCurrentCategory = cat;
      if (btn) {
        document.querySelectorAll('#assistedCategoryPills button').forEach(b => {
          b.classList.remove('btn-dark');
          b.classList.add('btn-outline-secondary');
        });
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-dark');
      }

      const bundles = {
        'kirana': { title: 'Kirana & Micro Retail Digital Starter', price: '₹1,999/mo', setup: '₹1,000 setup', inc: 'Biz 5G AirFiber 100Mbps, 4G Failover Router, WhatsApp API Starter, Secure Commercial Wi-Fi.' },
        'clinic': { title: 'Clinic & Professional Office Suite', price: '₹3,499/mo', setup: '₹1,500 setup', inc: '200 Mbps Optical Business Fiber, 1TB Cloud Backup (Compliant), Google Workspace Starter, Secure Wi-Fi.' },
        'multisite': { title: 'Multi-Site Retail & Restaurant Pro', price: '₹7,999/mo', setup: '₹3,000 setup', inc: '500 Mbps Optical Fiber, Managed SD-WAN Multi-Branch, Cloud CCTV 4 Cams, Managed Firewall.' },
        'manufacturer': { title: 'Small Manufacturing & Industrial Suite', price: '₹14,999/mo', setup: '₹5,000 setup', inc: 'Internet Leased Line 50 Mbps 1:1, Static IPv4 /29 Pool, Machine IoT Telemetry, Dedicated Manager.' }
      };

      const b = bundles[cat] || bundles['kirana'];
      document.getElementById('assistedBundleTitle').textContent = b.title;
      document.getElementById('assistedBundlePrice').textContent = b.price;
      document.getElementById('assistedIncludedServices').textContent = 'Includes: ' + b.inc;

      // Update Co-Pilot Real-time Advice
      fetch('/api/partner/copilot/advice', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          profile: { business_type: cat },
          identified_needs: ['connectivity:HighSpeed', 'business_continuity:UPI'],
          bundle_id: 'bundle_' + cat
        })
      })
      .then(r => r.json())
      .then(data => {
        if (data.status === 'success') {
          const adv = data.advice;
          document.getElementById('copilotRationale').textContent = adv.rationale;
          document.getElementById('copilotSatisfiedNeeds').textContent = adv.satisfied_needs.join(', ');
          
          const pBox = document.getElementById('copilotPromptsList');
          pBox.innerHTML = '';
          adv.consultative_prompts.forEach(p => {
            const d = document.createElement('div');
            d.className = 'p-2 bg-light border-start border-3 border-primary rounded';
            d.textContent = p;
            pBox.appendChild(d);
          });

          const oBox = document.getElementById('copilotObjectionsList');
          oBox.innerHTML = '';
          adv.anticipated_objections.forEach(o => {
            const d = document.createElement('div');
            d.className = 'p-2 bg-light border rounded';
            d.innerHTML = `<strong class="text-dark d-block">Objection: "${o.objection}"</strong><span class="text-muted">Rebuttal: ${o.rebuttal}</span>`;
            oBox.appendChild(d);
          });
        }
      });
    }

    function assistedSendAnswer() {
      const input = document.getElementById('assistedChatInput');
      const val = (input.value || '').trim();
      if (!val) return;

      const chatBox = document.getElementById('assistedChatBox');
      const userDiv = document.createElement('div');
      userDiv.className = 'p-2 mb-2 bg-light border rounded small text-end';
      userDiv.innerHTML = `<strong>Customer:</strong> ${val}`;
      chatBox.appendChild(userDiv);
      input.value = '';

      // AI response
      setTimeout(() => {
        const botDiv = document.createElement('div');
        botDiv.className = 'p-2 mb-2 bg-white border rounded small';
        botDiv.innerHTML = `<strong class="text-danger">Airtel Advisor:</strong> Samjhe. Aapke liye hamara guaranteed backup failover plan bilkul perfect rahega taaki evening rush mein payments na rukein.`;
        chatBox.appendChild(botDiv);
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 500);
    }

    function assistedRecalculatePricing() {
      // live toggle recalculation in assisted mode
    }

    function assistedPlaceCustomerOrder() {
      const singleId = (activePartnerId === 'ALL') ? 'PTR-DEL-042' : activePartnerId;
      const btype = assistedCurrentCategory;
      const bundleMap = { 'kirana': 'bundle_kirana', 'clinic': 'bundle_clinic', 'multisite': 'bundle_multisite', 'manufacturer': 'bundle_manufacturer' };
      
      const payload = {
        bundle_id: bundleMap[btype],
        ref_partner: singleId,
        business_name: 'Merchant Shop (Assisted Mode)',
        contact_name: 'Business Owner',
        phone: '+91 98110 55221',
        city: 'Delhi',
        gstin: '07AAACS1429B1ZB',
        addons: []
      };

      fetch('/api/consumer/order/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(r => r.json())
      .then(res => {
        if (res.status === 'success') {
          alert('Assisted Order Created: ' + res.order.order_id + '\nReferral attributed to ' + singleId + '\nCommission stamped: ₹1,500 PENDING activation.');
          const modalEl = document.getElementById('assistedModeModal');
          const modalInstance = bootstrap.Modal.getInstance(modalEl);
          if (modalInstance) modalInstance.hide();
          loadPartnerIntelligence();
        }
      });
    }

    // Initial load
    loadLiveOrders();
    loadKycQueue();
    loadRecoveryData();
    loadPartnerIntelligence();
  </script>

  <!-- Modal: Assisted Onboarding Tablet Mode (Dual-Aspect UI) -->
  <div class="modal fade" id="assistedModeModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
      <div class="modal-content border-0">
        <!-- Tablet Header Bar -->
        <div class="modal-header bg-dark text-white py-2 px-4 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-3">
            <span class="badge bg-danger fs-6 px-3 py-1 fw-bold"><i class="bi bi-tablet-landscape me-1"></i>ASSISTED TABLET MODE</span>
            <div class="vr bg-secondary" style="height: 20px;"></div>
            <span class="small text-white-50">Active Partner: <strong class="text-white" id="assistedActivePartnerName">Rajesh Gupta (MicroTech Solutions)</strong></span>
            <span class="badge bg-secondary font-monospace" id="assistedPartnerIdBadge">PTR-DEL-042</span>
          </div>
          <div class="d-flex align-items-center gap-3">
            <span class="badge bg-success bg-opacity-25 text-success border border-success"><i class="bi bi-shield-check me-1"></i>DPDP Act Consent Verified</span>
            <button type="button" class="btn btn-sm btn-outline-light" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Exit Tablet Mode</button>
          </div>
        </div>

        <div class="modal-body p-0 bg-light">
          <div class="container-fluid h-100 p-0">
            <div class="row g-0 h-100">
              
              <!-- LEFT PANE: Customer-Facing Onboarding Canvas (60% Width) -->
              <div class="col-lg-7 p-4 bg-white border-end d-flex flex-column" style="overflow-y: auto; max-height: calc(100vh - 56px);">
                
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                  <div>
                    <h5 class="fw-bold text-dark mb-0">Digital Needs Discovery</h5>
                    <span class="text-muted small">Show this screen to the business owner during consultation</span>
                  </div>
                  <span class="badge bg-light text-muted border px-2 py-1">Customer View (Clean &bull; Zero Internal CAC)</span>
                </div>

                <!-- Business Category Picker -->
                <div class="mb-3">
                  <label class="form-label small fw-bold text-muted text-uppercase">1. Business Type</label>
                  <div class="d-flex flex-wrap gap-2" id="assistedCategoryPills">
                    <button class="btn btn-sm btn-dark" onclick="assistedSelectCategory('kirana', this)"><i class="bi bi-shop me-1"></i>Kirana &amp; Retail</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="assistedSelectCategory('clinic', this)"><i class="bi bi-hospital me-1"></i>Clinic &amp; Office</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="assistedSelectCategory('multisite', this)"><i class="bi bi-diagram-3 me-1"></i>Multi-Site Retail</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="assistedSelectCategory('manufacturer', this)"><i class="bi bi-gear me-1"></i>Manufacturing</button>
                  </div>
                </div>

                <!-- Needs Assessment Chat Transcript -->
                <div class="mb-3">
                  <label class="form-label small fw-bold text-muted text-uppercase">2. Conversational Discovery</label>
                  <div id="assistedChatBox" class="p-3 bg-light border rounded-3 mb-2" style="max-height: 220px; overflow-y: auto;">
                    <div class="p-2 mb-2 bg-white border rounded small">
                      <strong class="text-danger">Airtel Advisor:</strong> Namaste! Aapki shop mein UPI payments aur billing machines ke liye internet chahiye?
                    </div>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="text" id="assistedChatInput" class="form-control" placeholder="Type customer's answer (Hindi, English, Hinglish)..." onkeydown="if(event.key==='Enter') assistedSendAnswer()">
                    <button class="btn btn-danger" onclick="assistedSendAnswer()"><i class="bi bi-send-fill"></i></button>
                  </div>
                </div>

                <!-- Recommended Bundle Presentation -->
                <div class="mb-3" id="assistedRecCard">
                  <div class="p-3 border rounded-3 bg-white shadow-sm border-danger">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="badge bg-success" id="assistedMatchBadge">95% Match</span>
                      <span class="badge bg-light text-muted border font-monospace" id="assistedQuoteIdBadge">QTE-2026-AST1</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1" id="assistedBundleTitle">Kirana &amp; Micro Retail Digital Starter</h5>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                      <h4 class="fw-bold text-danger mb-0" id="assistedBundlePrice">&#8377;1,999/mo</h4>
                      <span class="small text-muted">+ 18% GST (&#8377;360) &bull; One-time setup: &#8377;1,000</span>
                    </div>
                    <div class="small text-muted mb-2" id="assistedIncludedServices">
                      Includes: Biz 5G AirFiber 100Mbps, 4G Failover Router, WhatsApp API Starter, Secure Commercial Wi-Fi.
                    </div>

                    <!-- Add-on Switches Strip -->
                    <div class="p-2 bg-light border rounded small mb-3">
                      <span class="fw-bold d-block text-dark mb-1">Optional Modular Add-ons:</span>
                      <div class="d-flex flex-wrap gap-3">
                        <div class="form-check form-switch">
                          <input class="form-check-input" type="checkbox" id="assistedAddonCctv" onchange="assistedRecalculatePricing()">
                          <label class="form-check-label small" for="assistedAddonCctv">Cloud CCTV 2-Cam (+&#8377;1,200/mo)</label>
                        </div>
                        <div class="form-check form-switch">
                          <input class="form-check-input" type="checkbox" id="assistedAddonIp" onchange="assistedRecalculatePricing()">
                          <label class="form-check-label small" for="assistedAddonIp">Static IP Pool (+&#8377;500/mo)</label>
                        </div>
                        <div class="form-check form-switch">
                          <input class="form-check-input" type="checkbox" id="assistedAddonBackup" onchange="assistedRecalculatePricing()">
                          <label class="form-check-label small" for="assistedAddonBackup">Cloud Backup 1TB (+&#8377;450/mo)</label>
                        </div>
                      </div>
                    </div>

                    <!-- Customer Order Action Button -->
                    <button class="btn btn-danger w-100 fw-bold py-2 shadow-sm" onclick="assistedPlaceCustomerOrder()">
                      <i class="bi bi-check-circle-fill me-1"></i> Approve Quote &amp; Complete Doorstep KYC
                    </button>
                  </div>
                </div>

              </div>

              <!-- RIGHT PANE: Private Partner AI Co-Pilot (40% Width) -->
              <div class="col-lg-5 p-4 bg-light d-flex flex-column" style="overflow-y: auto; max-height: calc(100vh - 56px);">
                
                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                  <div>
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-robot text-danger me-2"></i>AI Sales Co-Pilot</h5>
                    <span class="text-muted small">Confidential coaching &bull; Visible ONLY to Partner</span>
                  </div>
                  <span class="badge bg-warning text-dark"><i class="bi bi-eye-slash-fill me-1"></i>Private View</span>
                </div>

                <!-- Co-Pilot Sales Rationale -->
                <div class="card p-3 border-0 shadow-sm rounded-3 mb-3 bg-white">
                  <span class="fw-bold small text-muted text-uppercase mb-1">Recommendation Intelligence</span>
                  <div class="small text-dark mb-2" id="copilotRationale">
                    Kirana Digital Starter selected based on price-sensitivity, single-store setup, and frequent evening UPI downtime.
                  </div>
                  <div class="row g-2 small">
                    <div class="col-12">
                      <strong class="text-success"><i class="bi bi-check2-circle me-1"></i>Satisfied Needs:</strong>
                      <div id="copilotSatisfiedNeeds" class="text-muted">100 Mbps FWA, 4G POS Failover, WhatsApp API</div>
                    </div>
                    <div class="col-12 mt-1" id="copilotUnmetBox" style="display: none;">
                      <strong class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Unmet Requirements:</strong>
                      <div id="copilotUnmetNeeds" class="text-muted">Cloud CCTV not in base plan. Pitch 2-Cam add-on.</div>
                    </div>
                  </div>
                </div>

                <!-- Consultative Sales Prompts (What to ask customer) -->
                <div class="card p-3 border-0 shadow-sm rounded-3 mb-3 bg-white">
                  <span class="fw-bold small text-muted text-uppercase mb-2"><i class="bi bi-chat-left-dots-fill text-primary me-1"></i>Consultative Field Prompts</span>
                  <div id="copilotPromptsList" class="d-flex flex-column gap-2 small">
                    <div class="p-2 bg-light border-start border-3 border-primary rounded">
                      Ask: "Aapki dukaan par shaam ke time UPI kitni baar fail hota hai?"
                    </div>
                    <div class="p-2 bg-light border-start border-3 border-primary rounded">
                      Tip: Remind the owner that 1 prevented payment outage covers the &#8377;66/day plan cost.
                    </div>
                  </div>
                </div>

                <!-- Anticipated Objections & Field Rebuttals -->
                <div class="card p-3 border-0 shadow-sm rounded-3 mb-3 bg-white">
                  <span class="fw-bold small text-muted text-uppercase mb-2"><i class="bi bi-shield-shaded text-danger me-1"></i>Anticipated Objections &amp; Rebuttals</span>
                  <div id="copilotObjectionsList" class="d-flex flex-column gap-2 small">
                    <div class="p-2 bg-light border rounded">
                      <strong class="text-dark d-block">Objection: "Comparing with Jio hotspot"</strong>
                      <span class="text-muted">Rebuttal: Consumer hotspots throttle after daily quota with zero SLA. Airtel Business delivers dedicated priority bandwidth with 4-hour doorstep MTTR.</span>
                    </div>
                  </div>
                </div>

                <!-- Partner Commission & Attribution Stamping Preview -->
                <div class="card p-3 border-0 shadow-sm rounded-3 bg-white mt-auto">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold small text-muted text-uppercase">Commission Ledger Stamping</span>
                    <span class="badge bg-success fs-6">&#8377;1,500</span>
                  </div>
                  <div class="small text-muted">
                    Eligibility: Automatically marked <strong>ELIGIBLE</strong> upon Step 5 Service Activation. Disbursed via weekly partner NEFT batch.
                  </div>
                </div>

              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
